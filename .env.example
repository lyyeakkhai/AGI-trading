# Infrastructure
DATABASE_URL=postgresql+asyncpg://trading:trading_dev@localhost:5432/trading_paper
REDIS_URL=redis://localhost:6379

# Exchange (Execution Service only — never used in paper mode)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Intelligence
X_API_TOKEN=your_x_api_token_here

# Model access
LLM_GATEWAY_URL=https://your-llm-gateway-url
LLM_GATEWAY_KEY=your_llm_gateway_key_here

# Service-to-service
HERMES_SERVICE_TOKEN=your_hermes_service_token_here
TRADINGAGENTS_SERVICE_TOKEN=your_tradingagents_service_token_here

# Owner authentication
DASHBOARD_AUTH_SECRET=your_dashboard_auth_secret_here

# App config (safe defaults — do not change for paper trading)
APP_ENV=development
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
